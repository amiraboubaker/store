# ---------------------------------------------------------------------------
# Settings shared by both stacks. Copied to .env on the first deploy.sh run.
# Per-stack settings live in backend/.env and frontend/.env.
# ---------------------------------------------------------------------------

# --- where the code lives on the VPS -----------------------------------------
# deploy.sh clones this repository into APP_DIR itself, so you never have to
# copy files around by hand. The branch must already exist on the remote.
APP_DIR=/home/ubuntu/store
REPO_URL=https://github.com/amiraboubaker/store.git
REPO_BRANCH=devops

# --- public domains (behind the nginx reverse proxy) -------------------------
# Each subdomain fronts a different stack. The nginx reverse proxy on the host
# terminates TLS (via certbot/Let's Encrypt) and forwards plain HTTP to the
# containers on loopback addresses.
FRONTEND_DOMAIN=rayesmodes.tn          # https://rayesmodes.tn
API_DOMAIN=api.rayesmodes.tn           # https://api.rayesmodes.tn
DB_DOMAIN=db.rayesmodes.tn             # https://db.rayesmodes.tn (phpMyAdmin)

# Email address registered with Let's Encrypt for certificate issuance/renewal.
CERTBOT_EMAIL=admin@rayesmodes.tn

# --- network -----------------------------------------------------------------
# Shared docker network created by deploy.sh so both stacks can resolve each
# other by container name if you ever need that.
STORE_NETWORK=store-net

# --- host timezone -----------------------------------------------------------
TZ=UTC

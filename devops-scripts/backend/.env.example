# ---------------------------------------------------------------------------
# Backend stack configuration.
# deploy.sh copies this file to .env and replaces the placeholder value below
# with a freshly generated secret. Edit .env afterwards - it is gitignored.
# To check nothing was missed later, run:
#   grep -E '^[A-Z_]+=GENERATE$' .env      # must print nothing
# (the plain "grep GENERATE .env" also matches the comments in this header.)
# ---------------------------------------------------------------------------

# --- container identity ------------------------------------------------------
COMPOSE_PROJECT_NAME=store-backend
MYSQL_CONTAINER=store-mysql
BACKEND_CONTAINER=rayesmodes-backend
PHPADMIN_CONTAINER=store-phpmyadmin
BACKEND_IMAGE_NAME=rayesmodes-backend
IMAGE_TAG=latest
TZ=UTC

# --- shared docker network (created by deploy.sh) ----------------------------
STORE_NETWORK=store-net

# --- published ports ---------------------------------------------------------
# BACKEND_PORT is what the browser talks to for API calls (VITE_API_URL).
BACKEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=5000
# MySQL stays on loopback so it is never reachable from the internet.
DB_BIND_ADDRESS=127.0.0.1
DB_PUBLIC_PORT=3306
# phpMyAdmin is published on every interface so it can be opened as
# http://SERVER_IP:8081. Set PHPADMIN_BIND_ADDRESS=127.0.0.1 to keep it local.
PHPADMIN_BIND_ADDRESS=0.0.0.0
PHPADMIN_PORT=8081

# --- database ----------------------------------------------------------------
# DB_USER MUST NOT BE "root".
# This value is passed to the mysql container as MYSQL_USER, and the official
# mysql image refuses to start when it is "root":
#   MYSQL_USER="root" ... cannot be used for the root user
# which surfaces as "container store-mysql is unhealthy".
DB_NAME=store
DB_USER=store_user
DB_PASSWORD=GENERATE
DB_ROOT_PASSWORD=GENERATE
DB_VOLUME=store-db-data

# --- mysql tuning ------------------------------------------------------------
# Small defaults so MySQL boots on a 1 GB VPS. Raise these if you have RAM.
MYSQL_BUFFER_POOL_SIZE=64M
MYSQL_MAX_CONNECTIONS=50

# --- CORS --------------------------------------------------------------------
# MUST contain the exact browser origin of the frontend, scheme + host + port.
# Replace these localhost entries with your real origin before going live.
#   CORS_ORIGIN=https://rayesmodes.smartdeveloper.tn,https://www.rayesmodes.smartdeveloper.tn
#   no domain yet, testing by IP:  CORS_ORIGIN=http://203.0.113.10
CORS_ORIGIN=http://localhost,http://localhost:3000,http://localhost:5173

# --- auth --------------------------------------------------------------------
JWT_SECRET=GENERATE
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=GENERATE
JWT_REFRESH_EXPIRATION=7d
PASSWORD_RESET_TOKEN_EXPIRATION=30m
BCRYPT_ROUNDS=12

# --- rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- bootstrap admin (created on first start) --------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=GENERATE
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# --- email / SMTP (leave blank to disable) -----------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# --- stripe (leave blank to disable) -----------------------------------------
STRIPE_SECRET_KEY=

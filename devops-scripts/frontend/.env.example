# ---------------------------------------------------------------------------
# Frontend stack configuration.
# deploy.sh copies this file to .env on the first run. Edit .env afterwards -
# it is gitignored.
#
# Changing VITE_* here requires a rebuild:  ./deploy.sh pull
# ---------------------------------------------------------------------------

# --- container identity ------------------------------------------------------
COMPOSE_PROJECT_NAME=store-frontend
FRONTEND_CONTAINER=rayesmodes-frontend
FRONTEND_IMAGE_NAME=rayesmodes-frontend
IMAGE_TAG=latest
TZ=UTC

# --- shared docker network (created by deploy.sh) ----------------------------
STORE_NETWORK=store-net

# --- published port ----------------------------------------------------------
# This is the address you open in the browser, e.g. http://SERVER_IP or
# https://your-domain.com when a reverse proxy sits in front of port 80.
# Bind to 127.0.0.1 once a reverse proxy terminates TLS for the subdomain;
# 0.0.0.0 exposes nginx directly on http://SERVER_IP with no certificate.
# FRONTEND_PORT is the HOST port the proxy connects to. It must NOT be 80 or
# 443 when a reverse proxy is present: the proxy already owns those, and
# pointing proxy_pass at the proxy itself causes a redirect loop. 3000 is the
# convention here.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000

# --- API endpoint baked into the bundle at build time ------------------------
# Use the PUBLIC URL of the backend stack. Do not use a container name: the
# bundle runs in the browser, not in Docker.
#   with a domain ..... https://api.your-domain.com
#   direct on a VPS ... http://203.0.113.10:5000
# No port when a reverse proxy terminates TLS on 443 for the subdomain.
VITE_API_URL=https://api.rayesmodes.smartdeveloper.tn

# --- EmailJS (optional, for the contact form) --------------------------------
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

NODE_ENV=production
PORT=5000

# Database
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=store_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=store

# CORS (comma separated allowlist)
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Email (leave blank to disable the contact form notification)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# Inbox that receives the contact form notifications.
# Defaults to EMAIL_FROM when blank.
EMAIL_TO=

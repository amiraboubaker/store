NODE_ENV=production
PORT=5000

# Database
DB_DIALECT=mysql
# Use "mysql" when running inside Docker Compose, or "localhost" for local dev
DB_HOST=mysql
DB_PORT=3306
DB_USER=store_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=store
# MySQL root password used by the docker-compose mysql service
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET
JWT_REFRESH_EXPIRATION=7d

# Password Reset
PASSWORD_RESET_TOKEN_EXPIRATION=30m

# Email (use app-specific password for Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=noreply@yourdomain.com
EMAIL_PASSWORD=CHANGE_ME_EMAIL_APP_PASSWORD
EMAIL_FROM=noreply@yourdomain.com

# Security
BCRYPT_ROUNDS=12
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Admin Bootstrap
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# Stripe
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
